rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil: profile_images/{uid}.jpg
    match /profile_images/{fileName} {

      // Cualquier usuario autenticado puede ver las fotos (se usan en los marcadores del mapa)
      allow read: if request.auth != null;

      // Solo el dueno sube su foto: imagen de menos de 5 MB
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
