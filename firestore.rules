rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Coleccion de usuarios: documento = uid
    match /users/{userId} {

      // Cualquier usuario autenticado puede leer (el mapa muestra a los demas usuarios en linea)
      allow read: if request.auth != null;

      // Crear: solo el propio usuario, con los campos correctos y enLinea=false, lat/lon en 0.0
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.nombre is string
                    && request.resource.data.telefono is string
                    && request.resource.data.enLinea == false
                    && request.resource.data.latitud == 0.0
                    && request.resource.data.longitud == 0.0
                    && !('password' in request.resource.data);

      // Actualizar: solo el propio usuario y sin cambiar uid ni email
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.enLinea is bool
                    && request.resource.data.latitud is number
                    && request.resource.data.longitud is number
                    && !('password' in request.resource.data);

      allow delete: if false;
    }
  }
}
